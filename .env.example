# This file targets LOCAL DEVELOPMENT. For production, copy
# `.env.production.example` instead — production must set APP_ENV=production,
# APP_DEBUG=false, a real database (not sqlite), and a non-sync queue driver.
APP_NAME="Business Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_URL=
# Host the Filament admin panel / Android app shell loads (e.g. app.zamzamint.com).
# Visiting "/" on this host redirects straight into /admin instead of the marketing page.
ADMIN_APP_HOST=
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_VERSION=2.112.2
APP_RELEASE_TYPE=patch
APP_RELEASE_DATE=2026-10-23

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=business_dashboard
# DB_USERNAME=root
# DB_PASSWORD=

# Optional isolated demo database. Run `php artisan demo:refresh`, then set
# DB_CONNECTION=demo locally if you want to browse demo data without touching
# your main database.
DEMO_DB_DATABASE=database/demo.sqlite

ADMIN_NAME="ZamZam Admin"
ADMIN_EMAIL=admin@example.com
# Required for `php artisan db:seed`; use at least 12 characters with uppercase,
# lowercase, number, and symbol.
ADMIN_PASSWORD=

BACKUP_RETAIN_FILES=10
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_PREDEPLOY=10
# The copy php artisan backup:restore takes of the database it is about to replace.
BACKUP_KEEP_PRERESTORE=5
BACKUP_APP_KEEP_DAILY=10
BACKUP_APP_KEEP_PREDEPLOY=3
BACKUP_HOURLY_ENABLED=true
BACKUP_DAILY_FULL_APP=true
BACKUP_SCHEDULE_TIME=02:00
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_BACKUP_AUTO_UPLOAD=false
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Cloudflare R2 off-site copy (needs no Google Workspace). Use a bucket of its own and an
# API token limited to it ("Object Read & Write"). The R2 Backups page can store these too.
BACKUP_R2_ENABLED=false
BACKUP_R2_AUTO_UPLOAD=false
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_PREFIX=erp-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Only to show the estimated bill in taka as well (optional).
BACKUP_R2_USD_BDT_RATE=
# Off-site copies are encrypted with this passphrase (openssl rand -base64 32). NOT APP_KEY.
# Keep a copy OUTSIDE the server: without it the off-site copies cannot be opened.
# Until it is set nothing is uploaded (BACKUP_OFFSITE_REQUIRE_ENCRYPTION=false to override).
BACKUP_ENCRYPTION_KEY=
BACKUP_OFFSITE_REQUIRE_ENCRYPTION=true
BACKUP_OFFSITE_DATABASE_KINDS=hourly,daily,predeploy
BACKUP_OFFSITE_APP_KINDS=daily
BACKUP_DRIVE_KEEP_HOURLY=48
BACKUP_DRIVE_KEEP_DAILY=30
BACKUP_DRIVE_KEEP_PREDEPLOY=10
BACKUP_DRIVE_APP_KEEP_DAILY=7
# Weekly restore test (php artisan backup:drill). Needs a MySQL user that may create databases
# named backup_drill_* only - see docs/backup-restore.md. Off while the username is empty.
BACKUP_DRILL_DB_USERNAME=
BACKUP_DRILL_DB_PASSWORD=
# How late a backup may be before the dashboard card and the alert say so.
BACKUP_STALE_HOURLY_MINUTES=150
BACKUP_STALE_DAILY_HOURS=30
# For an outside uptime monitor: GET /health/backups?token=... (404 while empty).
BACKUP_HEALTH_TOKEN=

# Safe default for SQLite/local/small installs. For larger MySQL/Redis deployments,
# database or redis drivers can be used with a queue worker.
# Production: set SESSION_DRIVER=redis and SESSION_CONNECTION=session (same
# Redis service as the queue/cache, its own database — see
# .env.production.example) so a high-traffic storefront isn't reading/writing
# a session row on every request.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Keep browser-to-server Livewire temporary uploads on a local, non-public
# disk. Final company media uses R2 only when it is enabled in Cloud Storage.
LIVEWIRE_TEMPORARY_UPLOAD_DISK=livewire-tmp
QUEUE_CONNECTION=sync
# Production: set QUEUE_CONNECTION=redis and run a supervised
# `php artisan queue:work` process (see docs/deployment.md "Redis on
# Coolify"). This is what actually makes AiAutoReplyJob/media-download/
# read-receipt follow-ups run in the background instead of inline.

CACHE_STORE=file
# Production: set CACHE_STORE=redis (same Redis service as the queue) so
# AiReplyService's FAQ/delivery-charge lookups are cached, not re-queried
# every AI tool round.
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis/predis (pure-PHP client, no server extension) is installed —
# REDIS_CLIENT default already matches it in config/database.php.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Each site's own SMTP (Settings -> Integrations -> Email Setup) is used first; these are the
# server-wide fallback. For Amazon SES see docs/email-ses-setup.md.
# Replace with a real business email before enabling outbound mail.
MAIL_FROM_ADDRESS="admin@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (optional, S3-compatible object storage). Only needed if/when
# the storefront's "public" disk is migrated off local server disk. Leave
# blank until a bucket + API token are created in the Cloudflare dashboard.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# Meta Graph API version shared by WhatsApp Cloud API and Messenger.
META_GRAPH_API_VERSION=v25.0
META_MAX_MEDIA_BYTES=26214400

# Native Android app-update push notifications (Firebase Cloud Messaging).
# Keep disabled locally unless you are testing with a real Firebase project.
# FIREBASE_CREDENTIALS should point to a service-account JSON file outside the
# repository. Hosted secret-value systems may use the base64 alternative.
# Use one credential source only; the file path takes precedence.
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=
FIREBASE_CREDENTIALS_JSON_BASE64=

VITE_APP_NAME="${APP_NAME}"
