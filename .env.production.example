# Production environment template for ZamZam ERP.
# Copy to `.env` on the server and fill in real values. This differs from
# `.env.example` (which targets local development) in the security- and
# scalability-critical settings called out below.

APP_NAME="ZamZam ERP"
# MUST be `production` (not `local`) and debug MUST be off, or the app leaks
# stack traces and configuration to visitors.
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-domain.com
ASSET_URL=
ADMIN_APP_HOST=app.your-domain.com
TRUSTED_PROXIES=*

APP_VERSION=2.120.0
APP_RELEASE_TYPE=minor
APP_RELEASE_DATE=2026-11-02

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Keep production logs quiet; `debug` is far too noisy.
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database — DO NOT run production on SQLite.
# SQLite allows only one writer at a time; the storefront, admin panel,
# courier webhooks and scheduled jobs all write concurrently and will hit
# "database is locked" errors under load. Use MySQL 8+ or PostgreSQL.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zamzam_erp
DB_USERNAME=zamzam
DB_PASSWORD=

# Strong password (12+ chars, mixed case, number, symbol) used once by the
# initial `php artisan db:seed`.
ADMIN_NAME="ZamZam Admin"
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=

BACKUP_RETAIN_FILES=10
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_PREDEPLOY=10
# The copy php artisan backup:restore takes of the database it is about to replace.
BACKUP_KEEP_PRERESTORE=5
BACKUP_APP_KEEP_DAILY=10
BACKUP_APP_KEEP_PREDEPLOY=3
BACKUP_HOURLY_ENABLED=true
BACKUP_DAILY_FULL_APP=true
BACKUP_SCHEDULE_TIME=02:00
GOOGLE_DRIVE_BACKUP_ENABLED=false
GOOGLE_DRIVE_BACKUP_AUTO_UPLOAD=false
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PATH=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Cloudflare R2 off-site copy (needs no Google Workspace). Use a bucket of its own and an
# API token limited to it ("Object Read & Write"). The R2 Backups page can store these too.
BACKUP_R2_ENABLED=false
BACKUP_R2_AUTO_UPLOAD=false
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_BUCKET=
BACKUP_R2_PREFIX=erp-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Only to show the estimated bill in taka as well (optional).
BACKUP_R2_USD_BDT_RATE=
# Off-site copies are encrypted with this passphrase (openssl rand -base64 32). NOT APP_KEY.
# Keep a copy OUTSIDE the server: without it the off-site copies cannot be opened.
# Until it is set nothing is uploaded (BACKUP_OFFSITE_REQUIRE_ENCRYPTION=false to override).
BACKUP_ENCRYPTION_KEY=
BACKUP_OFFSITE_REQUIRE_ENCRYPTION=true
BACKUP_OFFSITE_DATABASE_KINDS=hourly,daily,predeploy
BACKUP_OFFSITE_APP_KINDS=daily
BACKUP_DRIVE_KEEP_HOURLY=48
BACKUP_DRIVE_KEEP_DAILY=30
BACKUP_DRIVE_KEEP_PREDEPLOY=10
BACKUP_DRIVE_APP_KEEP_DAILY=7
# Weekly restore test (php artisan backup:drill). Needs a MySQL user that may create databases
# named backup_drill_* only - see docs/backup-restore.md. Off while the username is empty.
BACKUP_DRILL_DB_USERNAME=
BACKUP_DRILL_DB_PASSWORD=
# How late a backup may be before the dashboard card and the alert say so.
BACKUP_STALE_HOURLY_MINUTES=150
BACKUP_STALE_DAILY_HOURS=30
# For an outside uptime monitor: GET /health/backups?token=... (404 while empty).
BACKUP_HEALTH_TOKEN=

# Sessions/cache should not use the local filesystem in a multi-process /
# multi-server deployment. `database` also works (no extra service needed)
# if a Redis service isn't available yet, but `redis` is recommended once it
# is — every request reads/writes its session, so a high-traffic storefront
# hits the database on every single page load under `database`. SESSION_
# CONNECTION points sessions at their own Redis database (config/database.php
# `redis.session`, REDIS_SESSION_DB defaults to 2) instead of the CACHE_STORE
# one above, so a `php artisan cache:clear` can never sign out every active
# customer/admin session along with it.
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Do not point this at r2_public. Livewire first needs a local temporary file;
# the final field save writes to R2 after validation and image optimization.
LIVEWIRE_TEMPORARY_UPLOAD_DISK=livewire-tmp

# ---------------------------------------------------------------------------
# Queue — DO NOT use `sync` in production.
# With `sync`, jobs run inside the web request: courier webhooks, the
# external courier fraud check, and the CRM Inbox's AI auto-reply agent
# (up to 6 sequential LLM calls) would all block checkout/webhook responses,
# and job retries/backoff never fire.
# Recommended: `redis` (see docs/deployment.md "Redis on Coolify" for the
# one-click Redis resource + supervised queue-worker setup). `database`
# (needs only the jobs table + a running worker, no extra service) also
# works if a Redis service isn't available yet.
# Run `php artisan queue:work --sleep=1 --tries=3 --max-time=3600` as a
# supervised process (systemd / supervisor / Coolify persistent service)
# either way.
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=redis

# Same Redis service as the queue — caches CRM Inbox AI-agent lookups
# (FAQ/delivery-charge) so they're not re-queried on every AI tool round.
CACHE_STORE=redis

# predis/predis (pure-PHP client, no server extension) is installed —
# REDIS_CLIENT default already matches it in config/database.php.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="admin@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Meta Cloud API shared by CRM Inbox and storefront WhatsApp templates.
META_GRAPH_API_VERSION=v25.0
META_MAX_MEDIA_BYTES=26214400

# Firebase Cloud Messaging for native Android app-update alerts. Mount the
# service-account JSON as a read-only Coolify secret file and set its absolute
# path here. Never commit the JSON or expose it through a VITE_* variable.
# Use one credential source only; the file path takes precedence.
FIREBASE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json
# Alternative when the host supports secret values but not secret files:
FIREBASE_CREDENTIALS_JSON_BASE64=

VITE_APP_NAME="${APP_NAME}"
